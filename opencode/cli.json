{
  "theme": {
    "name": "catppuccin-black",
    "mode": "system"
  },
  "keybinds": {
    "leader": "ctrl+x",
    "app_exit": "<leader>q"
  },
  "diffs": {
    "wrap": "word",
    "tree": true,
    "single": false
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "show",
    "tabs": false,
    "grouping": "none",
    "markdown": "rendered"
  },
  "animations": true,
  "hints": {
    "onboarding": false
  },
  "attention": {
    "enabled": false
  },
  "debug": {
    "devtools": false,
    "turn_tokens": false
  },
  "terminal": {
    "title": true
  },
  "prompt": {
    "paste": "compact",
    "editor": true
  },
  "mouse": true
}
